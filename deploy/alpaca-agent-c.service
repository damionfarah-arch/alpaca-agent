[Unit]
Description=Alpaca trading agent loop -- Agent C (US-listed ETF-lookalike portfolio)
After=network-online.target
Wants=network-online.target
# if it crashes 5 times in 5 min, stop trying (likely a config error) --
# check:  journalctl -u alpaca-agent-c -n 50  ;  then:  systemctl reset-failed alpaca-agent-c
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=alpaca
Group=alpaca
# Shares the same codebase as Agent A/B (kept up to date by deploy/push.sh)
# via PYTHONPATH; its own WorkingDirectory/.env/data/dashboard port.
WorkingDirectory=/home/alpaca/alpaca-agent-c
Environment=PYTHONPATH=/home/alpaca/alpaca-agent
ExecStart=/home/alpaca/alpaca-agent/.venv/bin/python -m agent

Restart=always
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=alpaca-agent-c

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/alpaca/alpaca-agent-c/data
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false

[Install]
WantedBy=multi-user.target
