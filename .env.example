# =============================================================================
# alpaca-agent configuration  --  copy to .env and fill in.  NEVER commit .env.
# All monetary values are USD. This project does no GBP conversion internally.
# =============================================================================

# ---------------------------------------------------------------------------
# Alpaca credentials + endpoint
# ---------------------------------------------------------------------------
# Get keys from https://app.alpaca.markets/  (Paper vs Live are SEPARATE keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Which Alpaca endpoint to hit: "paper" or "live"
#   paper -> https://paper-api.alpaca.markets   (fake money, safe)
#   live  -> https://api.alpaca.markets         (REAL money)
ALPACA_ENV=paper

# Extra guard. Must be literally "true" for the app to even start when
# ALPACA_ENV=live. Prevents an accidental env flip from touching real money.
ALPACA_ALLOW_LIVE=false

# ---------------------------------------------------------------------------
# Execution mode  (independent of paper/live endpoint)
# ---------------------------------------------------------------------------
# shadow -> strategy runs, decisions are logged, NO orders are ever submitted.
#           A simulated portfolio (fills, positions, P&L) is tracked in the DB so
#           the dashboard shows real behaviour. No funds involved.
# live   -> orders are actually submitted to whichever ALPACA_ENV is set.
# Start in shadow. Do not change to "live" until you have reviewed shadow output.
EXECUTION_MODE=shadow

# Simulated starting USD cash for the shadow portfolio (shadow mode only).
SHADOW_STARTING_CASH=1000

# ---------------------------------------------------------------------------
# Universe  (comma-separated). Crypto uses Alpaca's SLASH format: BTC/USD
# ---------------------------------------------------------------------------
EQUITY_SYMBOLS=SPY,AAPL
CRYPTO_SYMBOLS=BTC/USD,ETH/USD

# ---------------------------------------------------------------------------
# Strategy: moving-average crossover
# ---------------------------------------------------------------------------
STRATEGY=ma_crossover
MA_FAST=20
MA_SLOW=50
BAR_TIMEFRAME=1H        # 1Min, 5Min, 15Min, 1H, 1D
BAR_LOOKBACK=200        # how many bars to pull for the calculation

# Deadband: if |fastMA - slowMA| / slowMA is below this %, the strategy stays
# NEUTRAL (holds current position) instead of flipping. Cuts whipsaw when the
# MAs are basically equal. Set 0 to disable.
MA_MIN_SPREAD_PCT=0.15

# ---------------------------------------------------------------------------
# Agent loop
# ---------------------------------------------------------------------------
LOOP_INTERVAL_SECONDS=300     # 5 min. Crypto trades 24/7; equities only in RTH.
TRADE_EQUITY_WHEN_CLOSED=false

# ---------------------------------------------------------------------------
# RISK RAILS  (hard caps -- enforced before every order)
# ---------------------------------------------------------------------------
# Max USD notional for any single order.
MAX_POSITION_NOTIONAL_USD=50

# Max total USD deployed into positions at any one time (across stocks+crypto).
# New buys that would push allocation past this are blocked.
MAX_TOTAL_ALLOCATION_USD=200

# Daily loss limit. If realized+unrealized P&L for the current day drops below
# -MAX_DAILY_LOSS_USD, trading auto-pauses until the next UTC day.
MAX_DAILY_LOSS_USD=20

# Optional: also pause if account equity drops this % below the day's opening
# equity. Set 0 to disable.
MAX_DAILY_LOSS_PCT=5

# ---------------------------------------------------------------------------
# KILL SWITCH  (checked at the top of every loop iteration)
# ---------------------------------------------------------------------------
# If this env var is "true" OR the file at KILL_SWITCH_FILE exists, the agent
# halts all trading immediately (positions are left untouched).
KILL_SWITCH=false
KILL_SWITCH_FILE=./KILL

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
DB_PATH=./data/agent.db

# ---------------------------------------------------------------------------
# Dashboard  (separate process, read-only view of the same DB)
# ---------------------------------------------------------------------------
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
DASHBOARD_POLL_SECONDS=30

# HTTP Basic Auth -- REQUIRED. Dashboard refuses to start if unset.
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
